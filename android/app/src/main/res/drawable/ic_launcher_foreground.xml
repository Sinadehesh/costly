<?xml version="1.0" encoding="utf-8"?>
<!--
  THE MASCOT, FURIOUS. The tier-3 "unhinged" face from CatWidget — narrowed
  angled eyes, yelling mouth — over the same red the angry card uses in-app.

  Traced from web/src/components/CatWidget.tsx so the launcher and the product
  are the same animal. VectorDrawable has no <circle>/<polygon>/<ellipse>, so
  every shape is a <path>; the geometry is otherwise unchanged.

  The paws gripping the ledge are dropped on purpose: they only read as paws
  when the cat is peeking over a widget card, and at 48dp those 6-unit
  rectangles collapse into unreadable slivers.

  The group maps the cat's 7..93 x 3..66 box into the adaptive icon's central
  safe zone (18..90 of 108): x' = 13 + 0.82x, y' = 25.7 + 0.82y, so no part of
  the face sits where a launcher mask can crop it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.82"
        android:scaleY="0.82"
        android:translateX="13"
        android:translateY="25.7">

        <!-- whiskers, drawn first so they sit behind the head and spill past the cheeks -->
        <path
            android:pathData="M7,47 L34,50"
            android:strokeColor="#0A0A0A"
            android:strokeWidth="3"
            android:strokeLineCap="round" />
        <path
            android:pathData="M7,56 L34,55"
            android:strokeColor="#0A0A0A"
            android:strokeWidth="3"
            android:strokeLineCap="round" />
        <path
            android:pathData="M93,47 L66,50"
            android:strokeColor="#0A0A0A"
            android:strokeWidth="3"
            android:strokeLineCap="round" />
        <path
            android:pathData="M93,56 L66,55"
            android:strokeColor="#0A0A0A"
            android:strokeWidth="3"
            android:strokeLineCap="round" />

        <!-- pointy ears -->
        <path
            android:fillColor="#0A0A0A"
            android:pathData="M26,24 L33,3 L49,18 Z" />
        <path
            android:fillColor="#0A0A0A"
            android:pathData="M74,24 L67,3 L51,18 Z" />

        <!-- head: rounded dome, flat bottom, as if peeking over a ledge -->
        <path
            android:fillColor="#0A0A0A"
            android:pathData="M14,66 V46 a36,33 0 0 1 72,0 V66 Z" />

        <!-- narrowed, angled, furious eyes -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M30,41 L47,48 L46,53 L30,47 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M70,41 L53,48 L54,53 L70,47 Z" />
        <path
            android:fillColor="#0A0A0A"
            android:pathData="M36.4,47 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0 Z" />
        <path
            android:fillColor="#0A0A0A"
            android:pathData="M58.4,47 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0 Z" />

        <!-- yelling mouth -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M43.5,59 a6.5,5 0 1,0 13,0 a6.5,5 0 1,0 -13,0 Z" />
    </group>
</vector>
